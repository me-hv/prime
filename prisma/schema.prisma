datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  dailyMissions      DailyMission[]
  creativeActivities CreativeActivity[]
  goals              Goal[]
  quickCaptures      QuickCapture[]
  writingDocuments   WritingDocument[]
  songs              Song[]
  projects           CreativeProject[]
  trainingSessions   TrainingSession[]
  rhymeChains        RhymeChain[]
  vocabularyEntries  VocabularyEntry[]
  artists            Artist[]
  artistReferences   ArtistReference[]
  studySessions      StudySession[]
  albumStudies       AlbumStudy[]
  listeningEntries   ListeningEntry[]
  dailyReflections   DailyReflection[]
  weeklyReviews      WeeklyReview[]
  bottlenecks        Bottleneck[]
  breakthroughs      Breakthrough[]
  milestones         Milestone[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String   @default("Artist")
  artistName   String   @default("PRIME Artist")
  bio          String   @default("Musician, writer, producer, and lyricist building a timeless catalog.")
  disciplines  String   @default("[\"Rap\", \"Songwriting\", \"Music Production\", \"Writing\"]")
  currentFocus String   @default("BUILD MY MUSIC CAREER & COMPLETE MY FIRST BODY OF WORK")
  vision       String   @default("Master the craft of songwriting, lyrical execution, and music production to establish a distinct, uncompromising artist catalog.")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailyMission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model CreativeActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  description     String?
  durationMinutes Int      @default(0)
  date            String
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String
  targetDate      String?
  status          String   @default("IN_PROGRESS")
  currentProgress Float    @default(0)
  targetProgress  Float    @default(100)
  unit            String   @default("%")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, category])
  @@index([userId, status])
}

model QuickCapture {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("IDEA")
  title       String?
  content     String
  tags        String?
  status      String   @default("INBOX") // INBOX, IN_PROGRESS, ARCHIVED
  convertedTo String?  // WRITING, SONG
  convertedId String?  // id of the created writing or song
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, createdAt])
}

model WritingDocument {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   @default("Untitled Draft")
  content        String   @default("")
  type           String   @default("FREE_WRITE") // FREE_WRITE, BARS, HOOK, VERSE, POEM, IDEA, LYRIC, CONCEPT, OTHER
  status         String   @default("DRAFT") // DRAFT, IN_PROGRESS, FINISHED, ARCHIVED
  tags           String?
  wordCount      Int      @default(0)
  characterCount Int      @default(0)
  trainingSessions TrainingSession[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, updatedAt])
}

model Song {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        @default("Untitled Song")
  concept     String?
  status      String        @default("IDEA") // IDEA, CONCEPT, WRITING, DEMO, RECORDING, MIXING, MASTERING, FINISHED, ARCHIVED
  genre       String?
  bpm         Int?
  musicalKey  String?
  mood        String?
  nextAction  String?
  tags        String?
  notes       String?
  wordCount   Int           @default(0)
  sections    SongSection[]
  projectSongs ProjectSong[]
  breakthroughs Breakthrough[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model SongSection {
  id         String   @id @default(cuid())
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  type       String   @default("VERSE") // HOOK, VERSE, BRIDGE, INTRO, OUTRO, PRE_CHORUS, NOTES, CUSTOM
  name       String   @default("Section")
  content    String   @default("")
  orderIndex Int      @default(0)
  collapsed  Boolean  @default(false)
  wordCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([songId, orderIndex])
}

model CreativeProject {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  type         String        @default("EP") // ALBUM, EP, MIXTAPE, PLAYLIST, COLLECTION, PROJECT
  status       String        @default("PLANNING") // IDEA, PLANNING, IN_PROGRESS, COMPLETED, ARCHIVED
  targetDate   String?
  notes        String?
  coverUrl     String?
  projectSongs ProjectSong[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model ProjectSong {
  id          String          @id @default(cuid())
  projectId   String
  project     CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  songId      String
  song        Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  trackNumber Int             @default(1)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, songId])
  @@index([projectId, trackNumber])
}

// ==========================================
// Phase 3: Training System Models
// ==========================================

model Skill {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  category    String          // RAP, WRITING, PRODUCTION, EAR_TRAINING, VOCABULARY
  description String?
  exercises   ExerciseSkill[]
  studySessions StudySession[]
  bottlenecks Bottleneck[]
  breakthroughs Breakthrough[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
}

model Exercise {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  description       String
  category          String          // RAP, WRITING, FLOW, RHYME, FREESTYLE, STORYTELLING, VOCABULARY, PRODUCTION, EAR_TRAINING
  difficulty        String          @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  estimatedDuration Int             @default(10) // minutes
  instructions      String
  constraints       String?         // Bulleted constraints or guidelines
  starterPrompt     String?         // Topic, starting bar, memory prompt, anchor word
  defaultBpm        Int?
  timeLimitSeconds  Int?            // e.g. 600 for 10 min sprint
  active            Boolean         @default(true)
  orderIndex        Int             @default(0)
  skills            ExerciseSkill[]
  sessions          TrainingSession[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([difficulty])
  @@index([active])
}

model ExerciseSkill {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, skillId])
  @@index([exerciseId])
  @@index([skillId])
}

model TrainingSession {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId        String
  exercise          Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  status            String             @default("COMPLETED") // NOT_STARTED, IN_PROGRESS, COMPLETED, ABANDONED
  startedAt         DateTime           @default(now())
  endedAt           DateTime?
  durationSeconds   Int                @default(0)
  effortRating      Int?               // 1-5
  difficultyRating  Int?               // 1-5
  confidenceRating  Int?               // 1-5
  notes             String?
  resultPayload     String?            // JSON string for drill-specific data
  writingDocumentId String?
  writingDocument   WritingDocument?   @relation(fields: [writingDocumentId], references: [id], onDelete: SetNull)
  rhymeChains       RhymeChain[]
  vocabularyEntries VocabularyEntry[]
  breakthroughs     Breakthrough[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([exerciseId])
}

model RhymeChain {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  anchorPhrase  String
  syllableCount Int             @default(1)
  notes         String?
  entries       RhymeEntry[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, createdAt])
}

model RhymeEntry {
  id         String     @id @default(cuid())
  chainId    String
  chain      RhymeChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  rhymeText  String
  syllables  Int?
  orderIndex Int        @default(0)
  notes      String?
  createdAt  DateTime   @default(now())

  @@index([chainId, orderIndex])
}

model VocabularyEntry {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  word         String
  definition   String
  pronunciation String?
  partOfSpeech String?
  userLine     String?
  associations String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, word])
  @@index([userId, createdAt])
}

// ==========================================
// Phase 4: Discovery & Reflection Models
// ==========================================

model Artist {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  role          String            @default("Rapper / Songwriter")
  notes         String?
  status        String            @default("STUDYING") // DISCOVERED, STUDYING, ACTIVE_REFERENCE, ARCHIVED
  genres        String?           // Comma-separated or JSON list
  tags          String?
  favorite      Boolean           @default(false)
  references    ArtistReference[]
  studySessions StudySession[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, status])
  @@index([userId, favorite])
  @@index([userId, name])
}

model ArtistReference {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String            @default("SONG") // SONG, ALBUM, ARTIST, BOOK, ARTICLE, INTERVIEW, VIDEO, OTHER
  title            String
  creator          String            // Artist, Author, Producer
  artistId         String?
  artist           Artist?           @relation(fields: [artistId], references: [id], onDelete: SetNull)
  year             Int?
  url              String?
  album            String?
  genre            String?
  notes            String?
  tags             String?
  favorite         Boolean           @default(false)
  studySessions    StudySession[]
  albumStudies     AlbumStudy[]
  listeningEntries ListeningEntry[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, type])
  @@index([userId, favorite])
  @@index([userId, artistId])
}

model StudySession {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId     String?
  reference       ArtistReference? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  artistId        String?
  artist          Artist?          @relation(fields: [artistId], references: [id], onDelete: SetNull)
  focus           String           @default("FLOW") // FLOW, CADENCE, WRITING, STORYTELLING, WORDPLAY, RHYME, HOOKS, DELIVERY, PRODUCTION, ARRANGEMENT, SAMPLING, SOUND_SELECTION, VOCABULARY, CONCEPT
  customFocus     String?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  durationSeconds Int              @default(0)
  observations    String?
  techniques      String?
  favoriteSection String?
  whyItWorks      String?
  whatSurprisedMe String?
  whatILearned    String?
  experimentIdea  String?
  takeaway        String?
  rating          Int?             // 1-5
  skillId         String?
  skill           Skill?           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  breakthroughs   Breakthrough[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, focus])
  @@index([userId, createdAt])
  @@index([referenceId])
  @@index([artistId])
}

model AlbumStudy {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId         String
  reference           ArtistReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  overallImpression   String?
  themes              String?
  productionNotes     String?
  writingNotes        String?
  sequencingNotes     String?
  standoutTracks      String?
  weakestTrack        String?
  recurringTechniques String?
  lessons             String?
  experimentIdeas     String?
  rating              Int?            // 1-5
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, referenceId])
  @@index([userId, createdAt])
}

model ListeningEntry {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId     String?
  reference       ArtistReference? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  title           String
  creator         String
  date            String           // YYYY-MM-DD
  durationMinutes Int              @default(15)
  purpose         String           @default("STUDY") // CASUAL, INSPIRATION, STUDY, PRODUCTION, WRITING, FLOW, RESEARCH
  mood            String?
  reaction        String?
  studyWorthy     Boolean          @default(false)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, date])
  @@index([userId, purpose])
  @@index([userId, studyWorthy])
}

model DailyReflection {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String   // YYYY-MM-DD
  // Creation
  created          String?
  finished         String?
  unfinished       String?
  // Practice
  practiced        String?
  skillWorked      String?
  difficulties     String?
  // Learning
  studied          String?
  learned          String?
  // Mindset
  energy           String?
  drained          String?
  distractions     String?
  // Creative Insight
  clicked          String?
  surprised        String?
  // Tomorrow
  continueItem     String?
  improveItem      String?
  tomorrowPriority String?
  // Context snapshot (JSON)
  snapshotStats    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklyReview {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart         String   // YYYY-MM-DD
  weekEnd           String   // YYYY-MM-DD
  outputNotes       String?
  learningNotes     String?
  weaknessesNotes   String?
  momentumNotes     String?
  breakthroughNotes String?
  nextFocus         String?
  statsSummary      String?  // JSON summary
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model Bottleneck {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          String    @default("FINISHING") // DISCIPLINE, DISTRACTION, WRITING, FLOW, VOCABULARY, RHYME, STORYTELLING, PRODUCTION, SONG_STRUCTURE, FINISHING, CONFIDENCE, TIME, ENERGY, OTHER
  description       String
  severity          Int       @default(3) // 1-5
  date              String    // YYYY-MM-DD
  attemptedSolution String?
  result            String?
  resolved          Boolean   @default(false)
  resolvedAt        DateTime?
  skillId           String?
  skill             Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, category])
  @@index([userId, resolved])
}

model Breakthrough {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  category          String           @default("FLOW") // FLOW, WRITING, PRODUCTION, MINDSET, PROCESS, TECHNIQUE, OTHER
  date              String           // YYYY-MM-DD
  description       String
  cause             String?
  changeEffect      String?
  skillId           String?
  skill             Skill?           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  songId            String?
  song              Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  trainingSessionId String?
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  studySessionId    String?
  studySession      StudySession?    @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, category])
  @@index([userId, date])
}

model Milestone {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  date         String   // YYYY-MM-DD
  category     String   @default("CREATION") // RELEASE, CREATION, PERFORMANCE, SKILL, MILESTONE, CAREER
  description  String
  significance String?
  lessons      String?
  nextStep     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, category])
}
