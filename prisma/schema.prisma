datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  dailyMissions      DailyMission[]
  creativeActivities CreativeActivity[]
  goals              Goal[]
  quickCaptures      QuickCapture[]
  writingDocuments   WritingDocument[]
  songs              Song[]
  projects           CreativeProject[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String   @default("Artist")
  artistName   String   @default("PRIME Artist")
  bio          String   @default("Musician, writer, producer, and lyricist building a timeless catalog.")
  disciplines  String   @default("[\"Rap\", \"Songwriting\", \"Music Production\", \"Writing\"]")
  currentFocus String   @default("BUILD MY MUSIC CAREER & COMPLETE MY FIRST BODY OF WORK")
  vision       String   @default("Master the craft of songwriting, lyrical execution, and music production to establish a distinct, uncompromising artist catalog.")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailyMission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model CreativeActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  description     String?
  durationMinutes Int      @default(0)
  date            String
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String
  targetDate      String?
  status          String   @default("IN_PROGRESS")
  currentProgress Float    @default(0)
  targetProgress  Float    @default(100)
  unit            String   @default("%")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, category])
  @@index([userId, status])
}

model QuickCapture {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("IDEA")
  title       String?
  content     String
  tags        String?
  status      String   @default("INBOX") // INBOX, IN_PROGRESS, ARCHIVED
  convertedTo String?  // WRITING, SONG
  convertedId String?  // id of the created writing or song
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, createdAt])
}

model WritingDocument {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   @default("Untitled Draft")
  content        String   @default("")
  type           String   @default("FREE_WRITE") // FREE_WRITE, BARS, HOOK, VERSE, POEM, IDEA, LYRIC, CONCEPT, OTHER
  status         String   @default("DRAFT") // DRAFT, IN_PROGRESS, FINISHED, ARCHIVED
  tags           String?
  wordCount      Int      @default(0)
  characterCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, updatedAt])
}

model Song {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        @default("Untitled Song")
  concept     String?
  status      String        @default("IDEA") // IDEA, CONCEPT, WRITING, DEMO, RECORDING, MIXING, MASTERING, FINISHED, ARCHIVED
  genre       String?
  bpm         Int?
  musicalKey  String?
  mood        String?
  nextAction  String?
  tags        String?
  notes       String?
  wordCount   Int           @default(0)
  sections    SongSection[]
  projectSongs ProjectSong[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model SongSection {
  id         String   @id @default(cuid())
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  type       String   @default("VERSE") // HOOK, VERSE, BRIDGE, INTRO, OUTRO, PRE_CHORUS, NOTES, CUSTOM
  name       String   @default("Section")
  content    String   @default("")
  orderIndex Int      @default(0)
  collapsed  Boolean  @default(false)
  wordCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([songId, orderIndex])
}

model CreativeProject {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  type         String        @default("EP") // ALBUM, EP, MIXTAPE, PLAYLIST, COLLECTION, PROJECT
  status       String        @default("PLANNING") // IDEA, PLANNING, IN_PROGRESS, COMPLETED, ARCHIVED
  targetDate   String?
  notes        String?
  coverUrl     String?
  projectSongs ProjectSong[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model ProjectSong {
  id          String          @id @default(cuid())
  projectId   String
  project     CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  songId      String
  song        Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  trackNumber Int             @default(1)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, songId])
  @@index([projectId, trackNumber])
}
