datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  dailyMissions      DailyMission[]
  creativeActivities CreativeActivity[]
  goals              Goal[]
  quickCaptures      QuickCapture[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String   @default("Artist")
  artistName   String   @default("PRIME Artist")
  bio          String   @default("Musician, writer, producer, and lyricist building a timeless catalog.")
  disciplines  String   @default("[\"Rap\", \"Songwriting\", \"Music Production\", \"Writing\"]")
  currentFocus String   @default("BUILD MY MUSIC CAREER & COMPLETE MY FIRST BODY OF WORK")
  vision       String   @default("Master the craft of songwriting, lyrical execution, and music production to establish a distinct, uncompromising artist catalog.")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailyMission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model CreativeActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  description     String?
  durationMinutes Int      @default(0)
  date            String
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String
  targetDate      String?
  status          String   @default("IN_PROGRESS")
  currentProgress Float    @default(0)
  targetProgress  Float    @default(100)
  unit            String   @default("%")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, category])
  @@index([userId, status])
}

model QuickCapture {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("IDEA")
  content   String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, createdAt])
}
